# ─────────────────────────────────────────────────────────────────────────────
# Kalba — environment template
# Copy to .env  (`cp .env.example .env`) and adjust. Never commit a real .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
# Matches the credentials in docker-compose.yml out of the box.
DATABASE_URL="postgresql://kalba:kalba@localhost:5432/kalba?schema=public"

# ── Backend ─────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT="4000"

# Secrets for signing JWTs. Generate with:  openssl rand -base64 48
# MUST be changed before deploying anywhere public.
JWT_ACCESS_SECRET="dev-only-access-secret-change-me-please-0000000000"
JWT_REFRESH_SECRET="dev-only-refresh-secret-change-me-please-000000000"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Comma-separated list of origins allowed to call the API.
CORS_ORIGIN="http://localhost:5173,http://localhost:4173"

# ── Google Sign-In (optional) ───────────────────────────────────────────────
# Create an OAuth 2.0 "Web application" client at
# https://console.cloud.google.com/apis/credentials
# Leave blank to disable the Google button — email/password still works.
GOOGLE_CLIENT_ID=""

# ── Kalba AI tutor (optional) ───────────────────────────────────────────────
# Without a key the tutor falls back to a local rule-based coach, so the app
# stays 100% usable for free. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"

# ── Frontend (Vite — only VITE_* vars reach the browser) ────────────────────
VITE_API_URL="http://localhost:4000"
VITE_GOOGLE_CLIENT_ID=""
